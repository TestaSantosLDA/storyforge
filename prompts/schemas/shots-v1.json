{
  "type": "object",
  "additionalProperties": false,
  "required": ["shots"],
  "properties": {
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scene_id", "line_ids", "characters", "actions", "setting", "framing", "camera"],
        "properties": {
          "id": {"type": "string"},
          "scene_id": {"type": "string"},
          "line_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "characters": {"type": "array", "items": {"type": "string"}},
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["character", "action"],
              "properties": {"character": {"type": "string"}, "action": {"type": "string"}}
            }
          },
          "setting": {"type": "string"},
          "framing": {"type": "string", "enum": ["wide", "medium", "close_up"]},
          "camera": {"type": "string", "enum": ["zoom_in", "zoom_out", "pan_left", "pan_right", "hold"]}
        }
      }
    }
  }
}
